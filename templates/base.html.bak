<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Online Order Fulfillment Tracker{% endblock %}</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
</head>
<body>
<header class="navbar">
    <div class="brand">Online Order Fulfillment Tracker</div>
    {% if session.get('user_id') %}
    <nav>
        <a href="{{ url_for('dashboard') }}">Dashboard</a>
        <a href="{{ url_for('orders') }}">Orders</a>
        {% if session.get('role') == 'customer' %}
        <a href="{{ url_for('new_order') }}">Place Order</a>
        {% endif %}
        <a href="{{ url_for('logout') }}">Log Out</a>
    </nav>
    {% endif %}
</header>

<main class="container">
    {% with messages = get_flashed_messages(with_categories=true) %}
        {% if messages %}
            {% for category, message in messages %}
            <div class="alert {{ category }}">{{ message }}</div>
            {% endfor %}
        {% endif %}
    {% endwith %}

    {% block content %}{% endblock %}
</main>

<footer>Online Order Fulfillment Tracker</footer>
</body>
</html>
